# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.ts text eol=lf
*.js text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf

# .NET
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf

# Windows-specific
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary
*.dll binary
*.exe binary
*.png binary
*.ico binary

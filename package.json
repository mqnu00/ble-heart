{
  "name": "ble-heart",
  "version": "1.0.0",
  "description": "BLE心率监测 - Windows自动锁屏/解锁",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "prebuild": "taskkill /F /IM \"BLE Heart Monitor.exe\" >nul 2>&1 || ver >nul",
    "prebuild:nsis": "taskkill /F /IM \"BLE Heart Monitor.exe\" >nul 2>&1 || ver >nul",
    "build": "npm run build:helper && npm run build:vite && electron-builder --dir",
    "build:nsis": "npm run build:helper && npm run build:vite && electron-builder",
    "build:vite": "vite build",
    "build:helper": "dotnet publish ble-helper/ble-helper.csproj -c Release -o dist-electron/ble-helper --self-contained true",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^5.0.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "element-plus": "^2.5.5",
    "sass": "^1.70.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5",
    "vue-tsc": "^1.8.27"
  },
  "build": {
    "appId": "com.bleheart.app",
    "productName": "BLE Heart Monitor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/main.js",
      "dist-electron/preload.js",
      "dist/**/*",
      "node_modules/**/*.js",
      "node_modules/**/*.json",
      "node_modules/**/package.json",
      "node_modules/koffi/build/koffi/win32_x64/*",
      "package.json"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "dist-electron/hodor",
        "to": "hodor"
      },
      {
        "from": "dist-electron/ble-helper",
        "to": "ble-helper"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png",
      "sign": null,
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
